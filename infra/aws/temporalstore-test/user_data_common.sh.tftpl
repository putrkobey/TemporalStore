#!/bin/bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y \
  nfs-common jq htop git tar gzip curl snapd nginx awscli \
  libprotobuf23 libgflags2.2 libleveldb1d libev4

snap install amazon-ssm-agent --classic || true
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service || systemctl enable --now amazon-ssm-agent || true

mkdir -p /mnt/temporalstore-shared
if ! grep -q "/mnt/temporalstore-shared" /etc/fstab; then
  echo "${efs_id}.efs.${region}.amazonaws.com:/ /mnt/temporalstore-shared nfs4 nfsvers=4.1,_netdev,noresvport,hard,timeo=600,retrans=2 0 0" >> /etc/fstab
fi
for _ in $(seq 1 60); do
  mount /mnt/temporalstore-shared && break
  sleep 2
done

