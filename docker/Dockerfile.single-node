# Single-node TemporalStore (Rust) — the simplest way to run it in Docker.
#
#   docker build -f docker/Dockerfile.single-node -t temporalstore:single-node .
#   docker run --rm -p 17101:17101 -p 17102:17102 temporalstore:single-node
#
# Or, from the repo root, one command:  docker compose -f docker-compose.single-node.yml up --build
#
# The image builds only the two service binaries it needs, so it is smaller and
# faster to build than the full multi-binary image (see ../Dockerfile).
FROM rust:1.87-bookworm AS builder
# librocksdb-sys (pulled in by matrixcache's `rocksdb-ssd` feature) runs bindgen
# at build time and needs libclang; building RocksDB itself needs cmake.
RUN apt-get update \
    && apt-get install -y --no-install-recommends clang libclang-dev cmake \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY proto ./proto
RUN cargo build --release -p temporalstore-rust \
      --bin matrixark_rust_metaserver \
