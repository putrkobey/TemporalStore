# TemporalStore Claude Code context-hook configuration.
#
# Source this (or copy the values into your shell profile) before starting Claude
# Code so tools/matrixark_claude_hook.sh picks them up. Claude's memory is scoped
# to its own agent/tenant, kept distinct from Codex.

# Backend for the Claude hook:
#   auto   (default) -> python conformance pipeline when the rust proxy is built, else rust
#   python           -> matrixark_agent_hook.py --agent claude (same engine as Codex)
#   rust             -> self-contained offline crate bin codex_context_hook
MATRIXARK_CLAUDE_HOOK_BACKEND=auto

# Agent identity + scope (kept separate from the codex tenant).
TEMPORALSTORE_AGENT_NAME=claude
MATRIXARK_AGENT_NAME=claude
MATRIXARK_ACCOUNT_ID=acct_claude
MATRIXARK_TENANT_ID=tenant_claude
MATRIXARK_USER_ID=local_user
MATRIXARK_TEAM=agent
TEMPORALSTORE_AGENT_PROJECT=TemporalStore
